      subst htp
      exfalso
      simp only [Slice.len] at hov hM
      scalar_tac
    · rename_i b h1 h2 t ht rM hM hov
      have htp := core.result.Result.Ok.inj ht
      subst htp
      exfalso
      simp only [Slice.len] at hov hM
      scalar_tac

