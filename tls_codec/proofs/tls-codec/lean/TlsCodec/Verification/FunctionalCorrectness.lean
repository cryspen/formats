    (tls_vec.TlsByteVecU8.deserialize_char bytes)
  rw [hr] at hr'
  have : r = r' := ok.inj hr'
  subst this
  cases r with
  | Err e =>
    show (do let a ← tls_vec.TlsByteVecU8.deserialize_bytes_bytes.post bytes (core.result.Result.Err e); pure (a = true)).holds
    simp only [tls_vec.TlsByteVecU8.deserialize_bytes_bytes.post, core.result.Result.is_err]
